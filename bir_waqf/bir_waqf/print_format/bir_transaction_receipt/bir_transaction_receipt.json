  "doc_type": "Bir Transaction",
  "doctype": "Print Format",
  "font": "Default",
  "html": "<div class=\"bir-print\">\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Tajawal:wght@300;400;500;700;800&display=swap');\n\n.bir-print {\n  --green-deep:   #0B3D2E;\n  --green-mid:    #145C43;\n  --green-soft:   #EAF2EE;\n  --gold:         #C6A15B;\n  --gold-light:   #E8D5A3;\n  --cream:        #FAF7F0;\n  --ink:          #1C2B24;\n  --ink-soft:     #5C6B63;\n  --line:         #D9CFB8;\n\n  direction: rtl;\n  font-family: 'Tajawal', sans-serif;\n  color: var(--ink);\n  background: var(--cream);\n  width: 100%;\n  max-width: 190mm;\n  margin: 0 auto;\n  padding: 15px;\n  box-sizing: border-box;\n  -webkit-print-color-adjust: exact;\n  print-color-adjust: exact;\n}\n.bir-print * { box-sizing: border-box; }\n\n.bir-corner {\n  position: absolute;\n  width: 34px;\n  height: 34px;\n  opacity: 0.9;\n}\n.bir-corner svg { width: 100%; height: 100%; display: block; }\n.bir-corner.tl { top: 10px; left: 10px; }\n.bir-corner.tr { top: 10px; right: 10px; transform: scaleX(-1); }\n\n.bir-header {\n  position: relative;\n  background: linear-gradient(135deg, var(--green-deep) 0%, var(--green-mid) 100%);\n  border-radius: 14px 14px 0 0;\n  padding: 26px 34px 22px;\n  color: #fff;\n  overflow: hidden;\n}\n.bir-header::after{\n  content:\"\";\n  position:absolute; inset:0;\n  background-image: repeating-linear-gradient(45deg, rgba(198,161,91,0.06) 0 2px, transparent 2px 14px);\n  pointer-events:none;\n}\n.bir-header-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 18px;\n  position: relative;\n  z-index: 1;\n}\n.bir-brand { display: flex; align-items: center; gap: 12px; }\n.bir-logo {\n  width: 54px; height: 54px;\n  border-radius: 10px;\n  background: rgba(255,255,255,0.08);\n  border: 1px solid rgba(232,213,163,0.5);\n  display: flex; align-items: center; justify-content: center;\n  overflow: hidden;\n  flex-shrink: 0;\n}\n.bir-logo img { width: 100%; height: 100%; object-fit: contain; }\n.bir-brand-text .bir-title {\n  font-family: 'Amiri', serif;\n  font-weight: 700;\n  font-size: 21px;\n  color: var(--gold-light);\n  line-height: 1.3;\n}\n.bir-brand-text .bir-sub {\n  font-size: 11.5px;\n  color: rgba(255,255,255,0.75);\n  margin-top: 2px;\n  letter-spacing: .3px;\n}\n.bir-doc-tag {\n  text-align: left;\n  font-size: 11px;\n  color: rgba(255,255,255,0.65);\n}\n.bir-doc-tag .bir-doc-no {\n  font-family: 'Tajawal', sans-serif;\n  font-weight: 800;\n  font-size: 16px;\n  color: #fff;\n  direction: ltr;\n  display: block;\n  margin-top: 3px;\n}\n.bir-gold-rule {\n  height: 3px;\n  background: linear-gradient(90deg, var(--gold) 0%, var(--gold-light) 50%, var(--gold) 100%);\n}\n\n.bir-doctitle {\n  background: var(--green-soft);\n  border-bottom: 1px solid var(--line);\n  padding: 14px 34px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n.bir-doctitle h1 {\n  font-family: 'Amiri', serif;\n  font-size: 17px;\n  font-weight: 700;\n  color: var(--green-deep);\n  margin: 0;\n}\n.bir-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 5px 14px;\n  border-radius: 999px;\n  font-size: 12px;\n  font-weight: 700;\n  border: 1px solid transparent;\n}\n.bir-badge.ok      { background:#E4F3EA; color:#1C6B3F; border-color:#BFE3CC; }\n.bir-badge.pending { background:#FCF3DC; color:#8A6416; border-color:#F0DFA9; }\n.bir-badge.failed  { background:#FBE7E7; color:#A03A3A; border-color:#F1C7C7; }\n.bir-badge .dot { width:7px; height:7px; border-radius:50%; background:currentColor; }\n\n.bir-body { background:#fff; padding: 26px 34px 18px; position: relative; }\n\n.bir-amount-block{\n  text-align:center;\n  padding: 10px 0 22px;\n  border-bottom: 1px dashed var(--line);\n  margin-bottom: 22px;\n}\n.bir-amount-label{ font-size:12px; color:var(--ink-soft); letter-spacing:.3px; }\n.bir-amount-value{\n  font-family:'Amiri', serif;\n  font-weight:700;\n  font-size:34px;\n  color: var(--green-deep);\n  margin-top: 4px;\n}\n.bir-amount-value .cur{ font-size:16px; color: var(--gold); font-family:'Tajawal',sans-serif; font-weight:700; margin-right:4px;}\n\n.bir-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0 28px;\n}\n.bir-field {\n  padding: 11px 0;\n  border-bottom: 1px solid #F0ECE0;\n  display:flex;\n  align-items:baseline;\n  justify-content:space-between;\n  gap: 10px;\n}\n.bir-field .k { font-size: 12px; color: var(--ink-soft); white-space:nowrap; }\n.bir-field .v { font-size: 13.5px; font-weight: 600; color: var(--ink); text-align:left; direction:ltr; unicode-bidi: plaintext; }\n\n.bir-basket-table {\n  width: 100%;\n  border-collapse: collapse;\n  margin-top: 15px;\n}\n.bir-basket-table th {\n  background: var(--green-soft);\n  color: var(--green-deep);\n  font-weight: 700;\n  padding: 8px 12px;\n  text-align: right;\n  border-bottom: 2px solid var(--gold);\n  font-size: 12px;\n}\n.bir-basket-table td {\n  padding: 8px 12px;\n  border-bottom: 1px solid #F0ECE0;\n  font-size: 12px;\n}\n\n.bir-flags{\n  margin-top: 18px;\n  display:flex;\n  gap:10px;\n  flex-wrap:wrap;\n}\n.bir-flag{\n  font-size:11px;\n  font-weight:700;\n  padding:5px 12px;\n  border-radius:8px;\n  background:#FBE7E7;\n  color:#A03A3A;\n  border:1px solid #F1C7C7;\n}\n\n.bir-footer {\n  margin-top: 26px;\n  padding: 16px 34px 22px;\n  border-top: 1px solid var(--line);\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap: 16px;\n}\n.bir-verse {\n  font-family:'Amiri', serif;\n  font-style: italic;\n  font-size: 12.5px;\n  color: var(--green-mid);\n}\n.bir-footer-meta {\n  font-size: 10px;\n  color: var(--ink-soft);\n  text-align:left;\n  line-height:1.6;\n}\n\n@media print {\n  .bir-print { max-width: 100%; }\n  .bir-header, .bir-doctitle, .bir-body, .bir-footer { padding-left: 16mm; padding-right: 16mm; }\n}\n</style>\n\n<div class=\"bir-header\">\n  <div class=\"bir-corner tl\"><svg viewBox=\"0 0 40 40\"><path d=\"M0 0 L40 0 L40 6 L6 6 L6 40 L0 40 Z\" fill=\"#C6A15B\"/><circle cx=\"6\" cy=\"6\" r=\"3.2\" fill=\"none\" stroke=\"#E8D5A3\" stroke-width=\"1.2\"/></svg></div>\n  <div class=\"bir-corner tr\"><svg viewBox=\"0 0 40 40\"><path d=\"M0 0 L40 0 L40 6 L6 6 L6 40 L0 40 Z\" fill=\"#C6A15B\"/><circle cx=\"6\" cy=\"6\" r=\"3.2\" fill=\"none\" stroke=\"#E8D5A3\" stroke-width=\"1.2\"/></svg></div>\n\n  <div class=\"bir-header-row\">\n    <div class=\"bir-brand\">\n      <div class=\"bir-logo\">\n        <img src=\"/assets/bir_waqf/images/albir-logo.png\" onerror=\"this.style.display='none'\" alt=\"منصة البر الوقفية\">\n      </div>\n      <div class=\"bir-brand-text\">\n        <div class=\"bir-title\">منصة البر الوقفية</div>\n        <div class=\"bir-sub\">الهيئة العامة للأوقاف والشؤون الإسلامية</div>\n      </div>\n    </div>\n    <div class=\"bir-doc-tag\">\n      رقم المعاملة\n      <span class=\"bir-doc-no\">{{ doc.transaction_id or doc.name }}</span>\n    </div>\n  </div>\n</div>\n<div class=\"bir-gold-rule\"></div>\n\n<div class=\"bir-doctitle\">\n  <h1>إيصال معاملة بر</h1>\n  {%- set status = doc.transaction_status or \"مكتمل\" -%}\n  {%- if status in [\"مكتمل\", \"Completed\", \"Success\"] -%}\n    <span class=\"bir-badge ok\"><span class=\"dot\"></span>{{ status }}</span>\n  {%- elif status in [\"معلق\", \"Pending\", \"قيد المعالجة\"] -%}\n    <span class=\"bir-badge pending\"><span class=\"dot\"></span>{{ status }}</span>\n  {%- else -%}\n    <span class=\"bir-badge failed\"><span class=\"dot\"></span>{{ status or \"غير محدد\" }}</span>\n  {%- endif -%}\n</div>\n\n<div class=\"bir-body\">\n\n  <div class=\"bir-amount-block\">\n    <div class=\"bir-amount-label\">القيمة الإجمالية للمعاملة</div>\n    <div class=\"bir-amount-value\">{{ \"%.2f\"|format(doc.total_amount or 0) }}<span class=\"cur\">د.ل</span></div>\n  </div>\n\n  <div class=\"bir-grid\">\n    <div class=\"bir-field\"><span class=\"k\">رقم طلب المساهمة</span><span class=\"v\">{{ doc.contribution_request_id or \"—\" }}</span></div>\n    <div class=\"bir-field\"><span class=\"k\">رقم الحوالة / الصك</span><span class=\"v\">{{ doc.transfer_number or \"—\" }}</span></div>\n\n    <div class=\"bir-field\"><span class=\"k\">المصرف</span><span class=\"v\" style=\"direction:rtl;\">{{ doc.bank_name or \"—\" }}</span></div>\n    <div class=\"bir-field\"><span class=\"k\">دفعة الاستيراد</span><span class=\"v\">{{ doc.import_batch or \"—\" }}</span></div>\n\n    <div class=\"bir-field\"><span class=\"k\">المستخدم / المتبرع</span><span class=\"v\" style=\"direction:rtl;\">{{ doc.donor_name or \"—\" }}</span></div>\n    <div class=\"bir-field\"><span class=\"k\">تاريخ المعاملة</span><span class=\"v\">{{ frappe.utils.format_datetime(doc.transaction_date) if doc.transaction_date else \"—\" }}</span></div>\n  </div>\n\n  {%- if doc.is_basket and doc.basket_projects %}\n  <div style=\"margin-top: 20px;\">\n    <h4 style=\"font-size: 14px; font-weight: 700; color: var(--green-deep); margin-bottom: 8px;\">مشاريع السلة الفرعية:</h4>\n    <table class=\"bir-basket-table\">\n      <thead>\n        <tr>\n          <th>#</th>\n          <th>اسم المشروع الفرعي</th>\n          <th style=\"text-align: left;\">المبلغ الفرعي</th>\n        </tr>\n      </thead>\n      <tbody>\n        {% for p in doc.basket_projects %}\n        <tr>\n          <td>{{ loop.index }}</td>\n          <td>{{ p.project_name }}</td>\n          <td style=\"text-align: left; font-weight: 700;\">{{ \"%.2f\"|format(p.sub_amount or 0) }} د.ل</td>\n        </tr>\n        {% endfor %}\n      </tbody>\n    </table>\n  </div>\n  {%- endif %}\n\n  {%- if doc.is_basket or doc.has_exception %}\n  <div class=\"bir-flags\">\n    {%- if doc.is_basket %}<span class=\"bir-flag\" style=\"background:#EAF2EE;color:#1C6B3F;border-color:#BFE3CC;\">معاملة سلة ({{ doc.basket_items_count or 0 }} مشاريع)</span>{%- endif %}\n    {%- if doc.has_exception %}<span class=\"bir-flag\">توجد استثناءات: {{ doc.exception_reason or \"\" }}</span>{%- endif %}\n  </div>\n  {%- endif %}\n\n</div>\n\n<div class=\"bir-footer\">\n  <div class=\"bir-verse\">﴿ لَن تَنَالُوا الْبِرَّ حَتَّىٰ تُنفِقُوا مِمَّا تُحِبُّونَ ﴾</div>\n  <div class=\"bir-footer-meta\">\n    تم الإصدار عبر منصة البر الوقفية — albir.ly<br>\n    {{ frappe.utils.format_datetime(frappe.utils.now()) }}\n  </div>\n</div>\n\n</div>\n",
  "line_breaks": 0,
  "module": "Bir Waqf",
  "name": "Bir Transaction Receipt",
  "owner": "Administrator",
  "print_format_builder": 0,
  "print_format_builder_beta": 0,
  "print_format_type": "Jinja",
  "raw_printing": 0,
  "show_section_headings": 0,
  "standard": "Yes"
}